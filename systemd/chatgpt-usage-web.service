[Unit]
Description=Panel web local del monitor de ChatGPT
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/chatgpt-usage
Environment=PYTHONPATH=%h/chatgpt-usage/src
Environment=CHATGPT_USAGE_WEB_PORT=8088
ExecStart=%h/chatgpt-usage/.venv/bin/python -m chatgpt_usage.web
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
